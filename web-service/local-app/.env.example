OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local Hyper-RAG backend started by npm start
HYPERRAG_URL=http://127.0.0.1:8788
HYPERRAG_DATABASE=kdb-v1.0.2-20261105
PORT=8787
# 노드 사전의 의약품안전나라 허가정보: 공공데이터포털 '식품의약품안전처_의약품 제품 허가정보' 일반 인증키 (없으면 HyperRx 요약을 보여 줌)
MFDS_API_KEY=
# 공개 서버용 (README "Docker로 배포"): 1이면 서버의 OPENAI_API_KEY를 쓰지 않고, 질문하는 사람이 설정에서 넣은 자기 키만 씁니다.
REQUIRE_USER_KEY=
# 웹 서버가 받을 주소. 이 컴퓨터에서만 쓰면 비워 둡니다(127.0.0.1). 컨테이너에서는 0.0.0.0입니다.
BIND_HOST=
# 127.0.0.1·localhost 밖에 허용할 공개 주소(쉼표로 구분). 예: hyperrx.example.org
ALLOWED_HOSTS=
